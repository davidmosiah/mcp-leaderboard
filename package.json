{
  "name": "mcp-leaderboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public agent-readiness leaderboard for the MCP ecosystem, scored by mcp-scorecard.",
  "scripts": {
    "corpus": "node scripts/build-corpus.mjs",
    "run": "node scripts/run-leaderboard.mjs",
    "render": "node scripts/render.mjs",
    "all": "npm run corpus && npm run run && npm run render && npm run render:site",
    "render:site": "node scripts/render-site.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leaderboard",
    "agent-readiness",
    "scorecard"
  ],
  "author": "David Mosiah",
  "license": "MIT",
  "devDependencies": {
    "mcp-scorecard": "0.5.10"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmosiah/mcp-leaderboard.git"
  },
  "homepage": "https://github.com/davidmosiah/mcp-leaderboard",
  "overrides": {
    "hono": "4.13.1",
    "@hono/node-server": "2.1.0",
    "fast-uri": "3.1.5",
    "ip-address": "10.4.0",
    "body-parser": "2.3.0",
    "dompurify": "3.4.13"
  }
}
